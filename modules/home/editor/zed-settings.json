{
  // Appearance
  "theme": "Neovim default dark",
  "theme_overrides": {
    "Neovim default dark": {
      "border": "#2c2e33",
      "editor.document_highlight.bracket_background": "#00000000",
      "syntax": {
        "keyword": { "color": "#ffcaff" },
        "function": { "color": "#a6dbff" },
        "constructor": { "color": "#8cf8f7" },
        "tag": { "color": "#8cf8f7" },
        "type": { "color": "#8cf8f7" },
        "property": { "color": "#a6dbff" },
        "string": { "color": "#b3f6c0" },
        "number": { "color": "#fce094" },
        "boolean": { "color": "#fce094" },
        "constant": { "color": "#fce094" },
        "operator": { "color": "#ffcaff" }
      }
    }
  },
  "icon_theme": "Material Icon Theme",
  "ui_font_family": "GeistMono Nerd Font",
  "ui_font_size": 15.0,
  "buffer_font_family": "GeistMono Nerd Font",
  "buffer_font_size": 15,
  "buffer_line_height": {
    "custom": 2
  },
  "agent_buffer_font_size": 15,
  "centered_layout": {
    "right_padding": 0.15,
    "left_padding": 0.15
  },

  // Window And Panels
  "title_bar": {
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_branch_name": false,
    "show_user_menu": false
  },
  "tab_bar": {
    "show": false
  },
  "toolbar": {
    "quick_actions": false
  },
  "status_bar": {
    "experimental.show": false
  },
  "project_panel": {
    "dock": "left",
    "default_width": 400,
    "hide_root": true,
    "auto_fold_dirs": false,
    "starts_open": false,
    "git_status": false,
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never"
    },
    "indent_guides": {
      "show": "never"
    }
  },
  "outline_panel": {
    "default_width": 300,
    "indent_guides": {
      "show": "never"
    }
  },
  "file_finder": {
    "modal_max_width": "large"
  },
  "scrollbar": {
    "show": "never"
  },
  "when_closing_with_no_tabs": "keep_window_open",
  "close_on_file_delete": true,
  "restore_on_file_reopen": false,
  "restore_on_startup": "empty_tab",

  // Editor
  "base_keymap": "VSCode",
  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
    "runnables": false
  },
  "indent_guides": {
    "enabled": false
  },
  "multi_cursor_modifier": "cmd_or_ctrl",
  "cursor_blink": false,
  "selection_highlight": false,
  "drag_and_drop_selection": {
    "enabled": false
  },
  "seed_search_query_from_cursor": "never",
  "show_whitespaces": "none",
  "tab_size": 2,
  "auto_indent_on_paste": false,
  "extend_comment_on_newline": false,
  "horizontal_scroll_margin": 1,
  "vertical_scroll_margin": 1,

  // Language Features
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    }
  },
  "show_completions_on_input": false,
  "show_completion_documentation": false,
  "inline_code_actions": false,
  "lsp_document_colors": "none",

  // Saving
  "format_on_save": "off",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },

  // Git
  "git": {
    "git_gutter": "hide",
    "inline_blame": {
      "enabled": false
    }
  },

  // Agent And Context Servers
  "disable_ai": true,
  "agent": {
    "default_profile": "ask",
    "threads_sidebar": {
      "position": "right"
    },
    "dock": "right",
    "default_model": {
      "effort": "high",
      "provider": "openai-subscribed",
      "model": "gpt-6.1-sol",
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "language_models": {
    "openai_compatible": {}
  },
  "context_servers": {
    "github-activity-summarizer": {
      "enabled": true,
      "remote": false,
      "settings": {}
    }
  },

  // Application And Session
  "cli_default_open_behavior": "new_window",
  "session": {
    "trust_all_worktrees": true
  },
  "auto_update": false
}
